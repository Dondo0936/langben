# cloud = we host (billing UI when Cloud self-serve is on)
# self-host = you run the MIT image (live product today)
VET_DEPLOYMENT=self-host

# Cloud Hobby/Core/Pro signup + plan switcher. Off until Cloud launches.
VET_CLOUD_SELF_SERVE=0

# Loopback locally. Live webhooks: paste the public origin on Kênh (localhost UI).
# https here is only a default until you save or clear origin on Kênh.
VET_PUBLIC_URL=http://localhost:43173

# Langfuse OSS console (docker compose, port 3000)
NEXT_PUBLIC_VET_CONSOLE_URL=http://localhost:3000
VET_CONSOLE_URL=http://localhost:3000
VET_CONSOLE_PROJECT_ID=prj-vet-demo
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-vet-demo
LANGFUSE_SECRET_KEY=sk-lf-vet-demo

# JSON store directory (SQLite/Postgres later; file is fine for the laptop demo)
VET_DATA_DIR=./data

# Cookie signing. Must be set in Cloud production.
# Empty or a placeholder generates a per-instance secret for self-host/dev
# (persisted at $VET_DATA_DIR/session.secret).
VET_SESSION_SECRET=

# Optional: Playground / wrapAnthropic
ANTHROPIC_API_KEY=
